{
  "mcpServers": {
    "issue-reader": {
      "command": "python",
      "args": [
        "oaa/tools/issue-reader/server/proxy/proxy.py"
      ],
      "env": {
        "GITHUB_ISSUES_TOKEN": "${GITHUB_ISSUES_TOKEN:-}"
      }
    },
    "github-read": {
      "command": "python",
      "args": [
        "oaa/tools/github-read/server/proxy/proxy.py"
      ],
      "env": {
        "GITHUB_READ_TOKEN": "${GITHUB_READ_TOKEN:-}"
      }
    }
  }
}