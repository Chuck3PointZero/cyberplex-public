{
  "mcpServers": {
    "issue-reader": {
      "command": "python",
      "args": [
        "oaa/tools/issue-reader/server/proxy/proxy.py"
      ],
      "env": {
        "GITHUB_ISSUES_TOKEN": "${GITHUB_ISSUES_TOKEN:-}"
      }
    },
    "oaa-ontology": {
      "command": "python",
      "args": [
        "oaa/tools/oaa-ontology/server/proxy/proxy.py"
      ],
      "env": {
        "OAA_ONTOLOGY_SERVER": "${OAA_ONTOLOGY_SERVER:-}"
      }
    }
  }
}