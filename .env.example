# Copy to .env (git-ignored). Never commit a real key.
# Your Cyberplex tenant API key. Each tool below uses it only to mint short-lived agent tokens.
# Shared spaces (collab-space):
CYBERPLEX_COLLAB_API_KEY=
# Team messaging on channels (team-channel). Normally the same tenant key as above:
CYBERPLEX_TEAM_API_KEY=
# Optional. Default: https://cyberplex.cpe.net
CYBERPLEX_COLLAB_URL=
CYBERPLEX_TEAM_URL=
